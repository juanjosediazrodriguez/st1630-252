# Copiar a entregable2/.env. El repositorio ya ignora todos los archivos .env.
# Recomendado: configurar un perfil local de AWS CLI y escribir solo su nombre.
AWS_PROFILE=tiendacol
AWS_REGION=us-east-1

# Identificador corto para los recursos del proyecto (letras minúsculas, números y guiones).
PROJECT_PREFIX=tiendacol

# Destinatarios de notificaciones. Pueden ser la misma dirección.
ALERT_EMAIL=tu-correo@example.com
BUDGET_EMAIL=tu-correo@example.com
MONTHLY_BUDGET_USD=25

# Alternativa a AWS_PROFILE: usar credenciales temporales en este archivo local.
# Si se usa esta opción, quitar AWS_PROFILE de arriba y descomentar las tres líneas.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
