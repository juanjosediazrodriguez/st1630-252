{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tiendacol/stock_changes/1.0",
  "title": "Cambio de stock por producto y bodega",
  "description": "PROPUESTA de P1 para la Fase 0. Clave de partición: product_id. El stock disponible = inventario inicial del maestro + suma de delta (los duplicados se descartan por event_id).",
  "type": "object",
  "required": ["event_id", "event_type", "event_ts", "schema_version", "product_id", "warehouse_id", "delta", "reason"],
  "properties": {
    "event_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "event_type": {"const": "stock_change"},
    "event_ts": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "schema_version": {"const": "1.0"},
    "product_id": {"type": "string"},
    "warehouse_id": {"type": "string"},
    "delta": {"type": "integer", "not": {"const": 0}},
    "reason": {"enum": ["sale", "restock", "return", "adjustment"]}
  }
}
