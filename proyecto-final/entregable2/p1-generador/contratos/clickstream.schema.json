{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tiendacol/clickstream/1.0",
  "title": "Evento de navegación (web / app)",
  "description": "PROPUESTA de P1 para la Fase 0. Clave de partición: user_id (session_id si el usuario es anónimo).",
  "type": "object",
  "required": ["event_id", "event_type", "event_ts", "schema_version", "session_id", "device", "city", "department"],
  "properties": {
    "event_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "event_type": {"enum": ["page_view", "search", "add_to_cart", "remove_from_cart", "checkout_start", "purchase"]},
    "event_ts": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "schema_version": {"const": "1.0"},
    "session_id": {"type": "string", "minLength": 1},
    "user_id": {"type": ["string", "null"]},
    "device": {"enum": ["desktop", "mobile_web", "app"]},
    "city": {"type": "string"},
    "department": {"type": "string"},
    "product_id": {"type": ["string", "null"]},
    "query": {"type": ["string", "null"]},
    "quantity": {"type": ["integer", "null"], "minimum": 1},
    "unit_price": {"type": ["number", "null"], "minimum": 0},
    "cart_value": {"type": ["number", "null"], "minimum": 0},
    "order_id": {"type": ["string", "null"]}
  },
  "allOf": [
    {"if": {"properties": {"event_type": {"enum": ["page_view", "add_to_cart", "remove_from_cart"]}}},
     "then": {"required": ["product_id"], "properties": {"product_id": {"type": "string"}}}},
    {"if": {"properties": {"event_type": {"const": "search"}}},
     "then": {"required": ["query"], "properties": {"query": {"type": "string"}}}},
    {"if": {"properties": {"event_type": {"enum": ["add_to_cart", "remove_from_cart"]}}},
     "then": {"required": ["quantity"], "properties": {"quantity": {"type": "integer"}}}},
    {"if": {"properties": {"event_type": {"enum": ["checkout_start", "purchase"]}}},
     "then": {"required": ["cart_value"], "properties": {"cart_value": {"type": "number"}}}},
    {"if": {"properties": {"event_type": {"const": "purchase"}}},
     "then": {"required": ["order_id"], "properties": {"order_id": {"type": "string"}}}}
  ]
}
